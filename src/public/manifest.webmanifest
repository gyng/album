{
  "name": "Snapshots",
  "short_name": "Snapshots",
  "description": "Fullscreen photo frame for the photo archive.",
  "id": "/",
  "start_url": "/slideshow/shell",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "theme_color": "#000000",
  "background_color": "#000000",
  "icons": [
    {
      "src": "/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
