{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["react", "react-dom"]
  },
  "include": [
    "License.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "services/types.ts",
    "styles.d.ts",
    "util/**/*.ts",
    "util/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "components/platform/next",
    "util/computeEmbeddingStats.ts",
    "util/convertlol.js",
    "util/lol2album.js"
  ]
}
