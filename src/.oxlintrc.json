{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "nextjs/no-img-element": "off",
    "nextjs/no-sync-scripts": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    ".vercel/**",
    "out/**",
    "build/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "next-env.d.ts",
    "public/**",
    "util/lol2album.js",
    "util/convertlol.js",
    "services/buildTiming.ts"
  ]
}
