{
  "name": "album",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "index:update": "(cd ../index; bash ./do-full-index.sh)",
    "index:embeddings:update": "(cd ../index; bash ./do-embeddings-index.sh)",
    "publish:wizard": "node ./bin/publish-wizard.cjs",
    "backup:publish": "node ./bin/backup-publish-assets.cjs",
    "backup:publish:with-albums": "node ./bin/backup-publish-assets.cjs --with-albums",
    "cleanup:media-cache": "node ./bin/cleanup-optimised-media.cjs",
    "prepare:build-manifest": "node ./bin/write-build-manifest.cjs",
    "deploy:vercel": "npx vercel build --prod && npx vercel deploy --prebuilt --prod",
    "predev": "node ./bin/check-node-version.cjs && npm run prepare:pwa-icons && npm run prepare:vendor-css",
    "dev": "npm run prepare:build-manifest && npm run prepare:feeds && next dev --turbopack",
    "benchmark:warm": "node ./bin/warm-build-benchmark.cjs",
    "benchmark:warm:strict": "ALBUM_BENCHMARK_FAIL_ON_BUDGET=1 node ./bin/warm-build-benchmark.cjs",
    "benchmark:route": "node --experimental-strip-types ./bin/map-route-benchmark.ts",
    "prepare:feeds": "node ./bin/generate-feeds.cjs",
    "prepare:pwa-icons": "node ./bin/prepare-pwa-icons.cjs",
    "prepare:vendor-css": "node ./bin/prepare-maplibre-css.cjs",
    "prepare:e2e-fixtures": "node ./bin/create-e2e-search-db.cjs --output ./public/e2e-search.sqlite --embeddings-output ./public/e2e-search-embeddings.sqlite --force",
    "build:prepare": "npm run typecheck && npm run cleanup:media-cache && npm run prepare:build-manifest && npm run prepare:feeds && npm run prepare:pwa-icons && npm run prepare:vendor-css",
    "build:e2e": "npm run prepare:e2e-fixtures && npm run build:prepare && NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_SEARCH_DATABASE_URL=/e2e-search.sqlite NEXT_PUBLIC_SEARCH_EMBEDDINGS_DATABASE_URL=/e2e-search-embeddings.sqlite ALBUM_INCLUDE_TEST_ALBUMS=1 ALBUM_SKIP_NEXT_TYPECHECK=1 next build && echo 'build done'",
    "build": "npm run build:prepare && ALBUM_SKIP_NEXT_TYPECHECK=1 next build && echo 'build done'",
    "build:profile": "npm run build:prepare && ALBUM_BUILD_PROFILE=1 ALBUM_SKIP_NEXT_TYPECHECK=1 next build && echo 'build done'",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:portable": "tsc --noEmit -p tsconfig.portable.json",
    "lint": "oxlint && biome lint . && npm run typecheck && npm run typecheck:portable",
    "lint:fix": "oxlint --fix && biome lint --write .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "test": "jest",
    "test:seo": "jest --runInBand test/seo.test.tsx test/alt.test.ts test/feed.test.ts services/albumFeed.test.ts",
    "test:ci": "timeout 60s jest --maxWorkers=50% && npm run lint && npm run format:check",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:reuse": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test",
    "test:e2e:headed": "npm run build:e2e && playwright test --headed",
    "screenshot": "playwright test --config=playwright.screenshot.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@nivo/core": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@sqlite.org/sqlite-wasm": "^3.51.2-build9",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "coi-serviceworker": "^0.1.7",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.9.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fraction.js": "^5.3.4",
    "image-size": "^2.0.2",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.7",
    "react-map-gl": "^8.1.1",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "25.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "usehooks-ts": {
      "react": "^19.2.4"
    }
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
