{
  "name": "geotag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local companion workbench for GPS and manual-lens metadata tagging. Shares pure logic from ../../src/util.",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^37.2.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "sharp": "^0.35.5",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
